{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "defaultSnapshot": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "parents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "date": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "author": {
            "type": "string"
          }
        },
        "required": [
          "sha",
          "parents",
          "refs",
          "date",
          "message",
          "author"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "defaultSnapshot",
    "generatedAt",
    "source",
    "snapshots"
  ],
  "additionalProperties": false
}
